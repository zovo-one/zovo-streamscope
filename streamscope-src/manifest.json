{
  "manifest_version": 3,
  "name": "Zovo Streamscope",
  "short_name": "Streamscope",
  "version": "1.0.0",
  "description": "Passive per-tab media inspector for stream URLs, format hints, page players, and session history. Never downloads files.",
  "minimum_chrome_version": "116",
  "homepage_url": "https://github.com/theluckystrike/zovo-streamscope",
  "icons": {
    "16": "icons/scope-16.png",
    "32": "icons/scope-32.png",
    "48": "icons/scope-48.png",
    "128": "icons/scope-128.png"
  },
  "action": {
    "default_title": "Zovo Streamscope",
    "default_popup": "scopeboard.html",
    "default_icon": {
      "16": "icons/scope-16.png",
      "32": "icons/scope-32.png",
      "48": "icons/scope-48.png"
    }
  },
  "background": {
    "service_worker": "scope-collector.worker.js"
  },
  "options_ui": {
    "page": "scope-settings.html",
    "open_in_tab": true
  },
  "permissions": [
    "tabs",
    "webRequest",
    "storage",
    "webNavigation",
    "clipboardWrite"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["scope-probe.content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "incognito": "split"
}
